# Lista donde se guardan todos los productos
productos = []

def agregar_producto():
    while True:
        nombre = input("Nombre del producto: ").strip()
        if nombre == "":
            print("Error: el nombre no puede estar vacío.")
        else:
            break

    while True:
        try:
            stock = int(input("Stock: "))
            if stock >= 0:
                break
            else:
                print("Error: el stock no puede ser negativo.")
        except ValueError:
            print("Error: ingresá un número entero válido.")

    while True:
        try:
            precio = float(input("Precio: "))
            if precio > 0:
                break
            else:
                print("Error: el precio debe ser mayor a 0.")
        except ValueError:
            print("Error: ingresá un número válido.")

    productos.append({"nombre": nombre, "stock": stock, "precio": precio})
    print("Producto agregado!")

def listar_productos():
    if len(productos) == 0:
        print("No hay productos cargados.")
    else:
        for p in productos:
            print(p["nombre"], "- Stock:", p["stock"], "- Precio:", p["precio"])

def listar_productos():
    if len(productos) == 0:
        print("No hay productos cargados.")
    else:
        for p in productos:
            print(p["nombre"], "- Stock:", p["stock"], "- Precio:", p["precio"])

def buscar_producto():
    nombre = input("¿Qué producto querés buscar? ")
    for p in productos:
        if p["nombre"] == nombre:
            print("Encontrado:", p)
            return
    print("No se encontró el producto.")

def modificar_producto():
    nombre = input("¿Qué producto querés modificar? ")
    for p in productos:
        if p["nombre"] == nombre:
            p["stock"] = int(input("Nuevo stock: "))
            p["precio"] = float(input("Nuevo precio: "))
            print("Producto modificado!")
            return
    print("No se encontró el producto.")

def eliminar_producto():
    nombre = input("¿Qué producto querés eliminar? ")
    for p in productos:
        if p["nombre"] == nombre:
            productos.remove(p)
            print("Producto eliminado!")
            return
    print("No se encontró el producto.")

def stock_bajo():
    for p in productos:
        if p["stock"] < 5:
            print(p["nombre"], "- Stock bajo:", p["stock"])

# Programa principal
while True:
    print("\n--- MENÚ ---")
    print("1 Agregar | 2 Listar | 3 Buscar")
    print("4 Modificar | 5 Eliminar | 6 Stock bajo | 0 Salir")
    opcion = int(input("Elegí una opción: "))

    if opcion == 0:
        print("¡Chau! Programa terminado.")
        break
    elif opcion == 1:
        agregar_producto()
    elif opcion == 2:
        listar_productos()
    elif opcion == 3:
        buscar_producto()
    elif opcion == 4:
        modificar_producto()
    elif opcion == 5:
        eliminar_producto()
    elif opcion == 6:
        stock_bajo()
    else:
        print("Opción inválida")
